{
  "name": "glossator-web",
  "version": "0.1.0",
  "private": true,
  "description": "The web app of glossator: every bibliography, article, search and the inbox, served by `glossator serve`.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev -H 127.0.0.1",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "lint": "eslint .",
    "typecheck": "NEXT_TELEMETRY_DISABLED=1 next typegen >/dev/null && tsc --noEmit -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "NEXT_TELEMETRY_DISABLED=1 playwright test",
    "serve:fixture": "node scripts/serve-fixture.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@ibm/plex-mono": "2.5.0",
    "@ibm/plex-sans-variable": "0.2.0",
    "@ibm/telemetry-js": "file:scripts/no-telemetry",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.70.0",
    "minisearch": "^7.2.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.2",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "source-serif": "4.5.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/turbopack": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "~7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "playwright-core": "1.62.1",
    "@ibm/telemetry-js": "$@ibm/telemetry-js"
  }
}
